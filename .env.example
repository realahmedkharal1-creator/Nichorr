# VeritasTech AI Environment Configuration

# App Configuration
NEXT_PUBLIC_APP_NAME="VeritasTech AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database & Supabase (Server-only & Browser Keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Server-only secret

# Primary AI Provider (Gemini - Server-only secret)
GEMINI_API_KEY="your-gemini-api-key"
PRIMARY_LLM_MODEL="gemini-1.5-flash"
HEAVY_LLM_MODEL="gemini-1.5-pro"

# Search Provider Configuration (Server-only secret)
SEARCH_PROVIDER="tavily" # 'tavily', 'mock'
TAVILY_API_KEY="your-tavily-api-key"

# Cost & Execution Controls
MAX_SEARCHES_PER_RUN=15
MAX_SOURCES_PER_RUN=25
MAX_LLM_CALLS_PER_RUN=20
MAX_RESEARCH_TIME_SECONDS=300
