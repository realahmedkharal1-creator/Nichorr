# Nichorr Environment Configuration

# App Configuration
NEXT_PUBLIC_APP_NAME="Nichorr"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database & Supabase (Server-only & Browser Keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Server-only secret

# Primary AI Provider (Gemini - Server-only secret)
GEMINI_API_KEY="your-gemini-api-key"
PRIMARY_LLM_MODEL="gemini-1.5-flash"
HEAVY_LLM_MODEL="gemini-1.5-pro"

# Search Provider Configuration (Server-only secret)
SEARCH_PROVIDER="tavily" # 'tavily' | 'serpapi' | 'mock'
TAVILY_API_KEY="your-tavily-api-key"
SERPAPI_API_KEY="your-serpapi-api-key"

# YouTube Intelligence (Server-only secret)
YOUTUBE_API_KEY="your-youtube-api-key"
# --- Transcript retrieval ---------------------------------------------------------------
# YouTube now blocks every free server-side transcript route from datacenter IPs (timedtext
# and InnerTube both need a browser-generated BotGuard token). The app still scrapes the
# watch page to DETECT whether captions exist, but for actual transcript-derived analysis
# (reviewer consensus / disagreements / gaps) you must point YT_TRANSCRIPT_API_URL at a
# transcript provider that runs residential proxies.
# The response must contain {content|transcript|segments: [{text, start|offset, dur|duration}]}.
# Use {videoId} as a placeholder in the URL; otherwise the id is appended as ?videoId=<id>.
#
# Example — Supadata (https://supadata.ai, free tier). Segment times are in ms, and each
# segment carries a `lang`, which the app auto-detects; or set YT_TRANSCRIPT_API_MS=1.
#   YT_TRANSCRIPT_API_URL="https://api.supadata.ai/v1/youtube/transcript?videoId={videoId}&text=false"
#   YT_TRANSCRIPT_API_KEY="sd_xxxxxxxx"
#
# Example — youtube-transcript.io / SearchApi.io style (times already in seconds):
#   YT_TRANSCRIPT_API_URL="https://www.searchapi.io/api/v1/search?engine=youtube_transcripts&video_id={videoId}"
#   YT_TRANSCRIPT_API_KEY="xxxxxxxx"
YT_TRANSCRIPT_API_URL=""
YT_TRANSCRIPT_API_KEY=""
# Set to 1 only if your provider returns segment start/duration in milliseconds and the
# app can't auto-detect it.
YT_TRANSCRIPT_API_MS=""

# Cost & Execution Controls
MAX_SEARCHES_PER_RUN=15
MAX_SOURCES_PER_RUN=25
MAX_LLM_CALLS_PER_RUN=20
MAX_RESEARCH_TIME_SECONDS=300
